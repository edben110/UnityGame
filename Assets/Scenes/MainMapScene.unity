--- !u!114 &650944587
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 650944583}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c3a5c9291e6aecb4880e21f1c693ac88, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueLibrary
  conversations:
  - id: prologue_intro
    nodes:
    - id: start
      lines:
      - speaker: Narrador
        text: Europa, 1943. La mansion de Simon recibe a cinco visitantes unidos
          por secretos.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: No estan aqui solo por duelo. Todos buscan algo.
        anxietyDelta: 5
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: 'Tu rol: observar, hablar y evitar que la ansiedad rompa al grupo.'
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices:
      - id: focus_group
        text: Prometer mantener unido al grupo
        nextNodeId: end
        anxietyDelta: -5
        requiredAnxietyMin: 0
        requiredAnxietyMax: 100
        requiredFlag: 
        setFlag: choice.prologue.unity
      - id: focus_truth
        text: Prometer buscar la verdad a cualquier costo
        nextNodeId: end
        anxietyDelta: 5
        requiredAnxietyMin: 0
        requiredAnxietyMax: 100
        requiredFlag: 
        setFlag: choice.prologue.truth
      nextNodeIdIfNoChoices: 
      endsConversation: 0
    - id: end
      lines:
      - speaker: Narrador
        text: 'Prologo completado. Comienza el Capitulo 1: La Llegada.'
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_intro
    nodes:
    - id: start
      lines:
      - speaker: Narrador
        text: Capitulo 1, 3:00 PM. El lobby esta en silencio.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Robert
        text: Llegue por una carta. No confio en esta reunion.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lisa
        text: La noticia de la muerte de Simon fue demasiado vaga.
        anxietyDelta: 3
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: Explora el mapa. Cada objeto puede alterar la ansiedad y la historia.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_lobby_book
    nodes:
    - id: start
      lines:
      - speaker: Narrador
        text: Examinas el libro de visitas. Una entrada esta tachada con tinta roja.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: 'Fecha: hace tres semanas. Nombre ilegible.'
        anxietyDelta: 8
        requiredFlag: 
        setFlag: clue.lobby.book
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_lobby_coat
    nodes:
    - id: start
      lines:
      - speaker: Narrador
        text: Revisas un abrigo colgado en el perchero. En el bolsillo hay una nota.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Nota
        text: No confies en nadie que haya llegado antes que tu.
        anxietyDelta: 6
        requiredFlag: 
        setFlag: clue.lobby.coat
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_lobby_photo
    nodes:
    - id: start
      lines:
      - speaker: Narrador
        text: "En la chimenea hay una foto antigua de Sim\xF3n con un hombre mayor."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: 'Al dorso: ''Padre e hijo, 1987''. Robert aparta la mirada.'
        anxietyDelta: 5
        requiredFlag: 
        setFlag: clue.lobby.photo
        addInventoryItemId: foto_padre_hijo
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_lobby_newspaper
    nodes:
    - id: start
      lines:
      - speaker: Narrador
        text: El periodico local esta doblado en la pagina de sucesos.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Titular
        text: Incendio en almacen del puerto, investigacion reabierta.
        anxietyDelta: 6
        requiredFlag: 
        setFlag: clue.lobby.newspaper
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_robert
    nodes:
    - id: start
      lines:
      - speaker: Robert
        text: Vine por una carta legal. Hay asuntos de herencia pendientes.
        anxietyDelta: -4
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Robert
        text: No confiaria en separarnos. Esta casa tiene mas preguntas que respuestas.
        anxietyDelta: -3
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La conversacion te ayuda a contener la tension del grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_robert_item_foto_padre_hijo
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: La foto de la chimenea dice 'Padre e hijo, 1987'.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Robert
        text: "No sabia que quedaba una copia aqui. Ese hombre era el padre de Sim\xF3n...
          y tambien el mio. No estoy listo para contarlo al resto."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_robert_item_lobby_book
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: En el libro de visitas hay una entrada tachada.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Robert
        text: Esa clase de tachadura no es casual. En tiempos asi, la gente borra
          nombres cuando teme represalias.
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_robert_item_lobby_coat
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: 'En el abrigo encontre una nota: ''No confies en nadie que haya llegado
          antes''.'
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Robert
        text: Suena a advertencia de alguien que conoce esta casa mejor que nosotros.
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_robert_item_lobby_newspaper
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: El periodico habla de un incendio en el puerto.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Robert
        text: Si reabrieron esa investigacion, alguien aqui va a ponerse nervioso.
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_ana
    nodes:
    - id: start
      lines:
      - speaker: Ana
        text: "Sim\xF3n era un cliente brillante, pero guardaba demasiado silencio."
        anxietyDelta: -4
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ana
        text: Si encontramos mas pistas en el lobby, podriamos entender por que nos
          llamo.
        anxietyDelta: -3
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La conversacion te ayuda a contener la tension del grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_ana_item_foto_padre_hijo
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: En la foto antigua Robert aparto la mirada enseguida.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ana
        text: "Lo vi. Esa reaccion no es casualidad. Si esa imagen sigue apareciendo
          en nuestras pistas, la historia familiar de Sim\xF3n es mas importante
          de lo que parece."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_ana_item_lobby_book
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: El libro de visitas tiene una entrada tachada.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ana
        text: En el arte, borrar un nombre es un mensaje. Alguien quiso que ese visitante
          no existiera.
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_ana_item_lobby_coat
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: Hay una nota escondida en un abrigo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ana
        text: Alguien dejo esa advertencia con tiempo. Eso significa premeditacion.
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_ana_item_lobby_newspaper
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: El periodico menciona un incendio reabierto.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ana
        text: "Si Sim\xF3n fue testigo, ese caso explica por que nos reunieron."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_ben
    nodes:
    - id: start
      lines:
      - speaker: Ben
        text: Yo llevaba las cuentas. No quiero problemas, solo aclarar todo.
        anxietyDelta: -4
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ben
        text: Escucha, si hablas conmigo seguido me mantengo estable. Si me dejas
          solo, me derrumbo.
        anxietyDelta: -3
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La conversacion te ayuda a contener la tension del grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_ben_item_foto_padre_hijo
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: Necesito que me digas que sabes de la foto de la chimenea.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ben
        text: "Si la foto menciona al padre de Sim\xF3n, entonces hay herencias y
          decisiones viejas metidas en esto. Robert sabe algo, seguro."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_ben_item_lobby_book
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: El libro de visitas tiene una entrada tachada.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ben
        text: Ese tipo de detalle es lo que termina costando dinero... y vidas.
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_ben_item_lobby_coat
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: Una nota escondida en un abrigo dice que no confiemos en quien llego
          antes.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ben
        text: Si alguien llego antes, tuvo tiempo de preparar algo. Eso me inquieta.
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_ben_item_lobby_newspaper
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: El periodico habla de un incendio y una investigacion reabierta.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ben
        text: Ese incendio fue un desastre financiero. Si alguien insiste en reabrirlo,
          es porque hay culpables.
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_lisa
    nodes:
    - id: start
      lines:
      - speaker: Lisa
        text: La version oficial de su muerte no me convence.
        anxietyDelta: -4
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lisa
        text: Si encontramos evidencia real, podremos proteger al grupo de decisiones
          ciegas.
        anxietyDelta: -3
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La conversacion te ayuda a contener la tension del grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_lisa_item_foto_padre_hijo
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: 'Encontramos una foto: ''Padre e hijo, 1987''.'
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lisa
        text: "Esa foto conecta con lo que investigaba. Si Robert evita mirarla,
          es porque teme que alguien ate su nombre al de Sim\xF3n."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_lisa_item_lobby_book
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: El libro de visitas tiene un nombre borrado.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lisa
        text: Eso es lo primero que revisaria si estuviera investigando. Ocultar
          un nombre es una pista en si misma.
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_lisa_item_lobby_coat
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: En el abrigo hay una nota de advertencia.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lisa
        text: Eso suena a alguien intentando salvarnos sin exponerse. Quiero saber
          quien la escribio.
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_lisa_item_lobby_newspaper
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: El periodico menciona un incendio reabierto.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lisa
        text: "Ese es el incidente que vengo siguiendo. Sim\xF3n estaba ahi."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_lucas
    nodes:
    - id: start
      lines:
      - speaker: Lucas
        text: "Trabaje con Sim\xF3n en el taller. Conozco varios rincones de la mansion."
        anxietyDelta: -4
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lucas
        text: Si notas que mi ansiedad sube, hablame antes de explorar otra zona.
        anxietyDelta: -3
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La conversacion te ayuda a contener la tension del grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_lucas_item_foto_padre_hijo
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: "Quiero preguntarte por la foto de Sim\xF3n con un hombre mayor."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lucas
        text: "Sim\xF3n nunca hablaba de su familia, pero guardaba esa foto cerca
          del fuego, como si la mirara seguido. Esa pista importa."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_lucas_item_lobby_book
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: En el libro de visitas hay una entrada tachada.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lucas
        text: "Sim\xF3n era cuidadoso con sus visitas. Si borro a alguien, ese alguien
          tenia peso."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_lucas_item_lobby_coat
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: En el abrigo hay una nota que advierte desconfiar.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lucas
        text: "Suena a Sim\xF3n. Siempre dejaba pistas como si no pudiera hablar
          directo."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_npc_lucas_item_lobby_newspaper
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: El periodico habla del incendio del puerto.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lucas
        text: "Sim\xF3n menciono ese incendio una vez. Dijo que alguien miente sobre
          lo que paso."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La reaccion abre una nueva capa de la historia sin romper el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter1_decision
    nodes:
    - id: start
      lines:
      - speaker: Narrador
        text: La tension en el lobby sube. Debes decidir como continua el grupo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices:
      - id: go_together
        text: Explorar juntos la mansion
        nextNodeId: result_together
        anxietyDelta: -12
        requiredAnxietyMin: 0
        requiredAnxietyMax: 100
        requiredFlag: 
        setFlag: chapter1.choice.together
      - id: split
        text: Separarse para cubrir mas terreno
        nextNodeId: result_split
        anxietyDelta: 14
        requiredAnxietyMin: 0
        requiredAnxietyMax: 100
        requiredFlag: 
        setFlag: chapter1.choice.split
      - id: talk
        text: Forzar una conversacion sincera sobre Simon
        nextNodeId: result_talk
        anxietyDelta: -4
        requiredAnxietyMin: 0
        requiredAnxietyMax: 100
        requiredFlag: 
        setFlag: chapter1.choice.talk
      nextNodeIdIfNoChoices: 
      endsConversation: 0
    - id: result_together
      lines:
      - speaker: Narrador
        text: El grupo avanza unido. El miedo sigue, pero nadie queda solo.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
    - id: result_split
      lines:
      - speaker: Narrador
        text: Cada quien toma una direccion. La mansion traga el sonido de los pasos.
        anxietyDelta: 6
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: Se desbloquea una ruta mas oscura para capitulo 2.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: route.dark
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
    - id: result_talk
      lines:
      - speaker: Narrador
        text: Nadie dice toda la verdad, pero el silencio deja de ser absoluto.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
