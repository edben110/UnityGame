        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: Ha llegado a un punto sin retorno. La casa lo ha roto.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter3_npc_lisa_critical
    nodes:
    - id: start
      lines:
      - speaker: Lisa
        text: "Hay alguien m\xE1s en la casa. Lo siento. Lo huelo. La sexta persona
          est\xE1 aqu\xED."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lisa
        text: Ya no importa nada. Ya no importa.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: Ha llegado a un punto sin retorno. La casa lo ha roto.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter3_npc_lucas_critical
    nodes:
    - id: start
      lines:
      - speaker: Lucas
        text: "El relicario. Rob\xE9 el relicario y Sim\xF3n lo sabe. Siempre lo
          supo. Esta es mi condena."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lucas
        text: Ya no importa nada. Ya no importa.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: Ha llegado a un punto sin retorno. La casa lo ha roto.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter3_npc_robert_item_carta
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: "La carta dice que Sim\xF3n podr\xEDa estar vivo."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Robert
        text: "Si est\xE1 vivo... entonces esto no es un funeral. Es una trampa.
          Y todos ca\xEDmos en ella."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La verdad se acerca. Y con ella, el peligro.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter3_npc_ana_item_mapa
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: "El mapa se\xF1ala el Ala Norte. \xBFSab\xEDas que exist\xEDa?"
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ana
        text: "No. Nunca vi esa parte de la mansi\xF3n. Sim\xF3n nunca la mencion\xF3
          en nuestros tratos."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La verdad se acerca. Y con ella, el peligro.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter3_npc_ben_item_llave_pequena
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: "Encontr\xE9 una llave peque\xF1a en la mesita de noche."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ben
        text: "\xBFUna llave peque\xF1a? Eso... eso podr\xEDa abrir el archivador
          del estudio. No, no vayas. No abras eso."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La verdad se acerca. Y con ella, el peligro.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter3_npc_lisa_item_vaso
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: "El vaso de agua todav\xEDa tiene condensaci\xF3n. Sim\xF3n estuvo
          aqu\xED hace muy poco."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lisa
        text: "Horas. Tal vez menos. Esto confirma mi teor\xEDa. La muerte fue un
          montaje."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La verdad se acerca. Y con ella, el peligro.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter3_npc_lucas_item_cama
    nodes:
    - id: start
      lines:
      - speaker: Jugador
        text: "La cama est\xE1 deshecha y todav\xEDa tibia."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lucas
        text: "Era su costumbre. Nunca hac\xEDa la cama. Dec\xEDa que era un ritual
          in\xFAtil para gente que no vive de verdad."
        anxietyDelta: -2
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: La verdad se acerca. Y con ella, el peligro.
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
  - id: chapter3_decision
    nodes:
    - id: start
      lines:
      - speaker: Narrador
        text: "La habitaci\xF3n de Sim\xF3n ha revelado la verdad. Sim\xF3n est\xE1
          vivo. Hay alguien m\xE1s en la mansi\xF3n. Y tienes una llave que podr\xEDa
          abrir respuestas."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: "\xBFCu\xE1l es tu pr\xF3ximo paso?"
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      choices:
      - id: return_archivador
        text: "Volver al estudio con la llave peque\xF1a para abrir el archivador"
        nextNodeId: result_archivador
        anxietyDelta: 4
        requiredAnxietyMin: 0
        requiredAnxietyMax: 100
        requiredFlag: clue.habitacion.llave_pequena
        setFlag: chapter3.choice.archivador
      - id: go_north_wing
        text: Buscar el Ala Norte marcada en el mapa
        nextNodeId: result_north_wing
        anxietyDelta: 12
        requiredAnxietyMin: 0
        requiredAnxietyMax: 100
        requiredFlag: clue.habitacion.mapa_ala_norte
        setFlag: chapter3.choice.north_wing
      - id: confront_group
        text: "Mostrar la carta de Sim\xF3n a todos"
        nextNodeId: result_confront_group
        anxietyDelta: 10
        requiredAnxietyMin: 0
        requiredAnxietyMax: 100
        requiredFlag: clue.habitacion.carta_inconclusa
        setFlag: chapter3.choice.confront_group
      nextNodeIdIfNoChoices: 
      endsConversation: 0
    - id: result_archivador
      lines:
      - speaker: Narrador
        text: "Decides volver al estudio. El archivador guarda los secretos que Sim\xF3n
          quer\xEDa proteger. La llave peque\xF1a encaja perfectamente."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: "Dentro encuentras carpetas, documentos, fotograf\xEDas. Todo apunta
          a una verdad m\xE1s grande que la que imaginabas."
        anxietyDelta: 5
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: "Sim\xF3n no muri\xF3 por accidente. Fue deliberado."
        anxietyDelta: 8
        requiredFlag: 
        setFlag: chapter3.archivador_abierto
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
    - id: result_north_wing
      lines:
      - speaker: Narrador
        text: "Decides seguir el mapa hacia el Ala Norte. Es la secci\xF3n m\xE1s
          antigua de la mansi\xF3n. Sim\xF3n dijo estar ah\xED."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: "Los pasillos son cada vez m\xE1s estrechos. Las paredes weep agua.
          La estructura chirr\xEDa bajo tus pies."
        anxietyDelta: 10
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: "Encuentras una puerta. Est\xE1 abierta. Y adentro..."
        anxietyDelta: 15
        requiredFlag: 
        setFlag: chapter3.ala_norte_explorada
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
    - id: result_confront_group
      lines:
      - speaker: Jugador
        text: "Escuchen todos. Encontr\xE9 una carta de Sim\xF3n. Dice que no est\xE1
          muerto. Y que hay alguien m\xE1s aqu\xED en la mansi\xF3n."
        anxietyDelta: 0
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ana
        text: "\xBFQu\xE9? No... eso no tiene sentido. Vimos el cuerpo."
        anxietyDelta: 12
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Ben
        text: "Nos mintieron. Todo esto es una trampa. \xBFPor qu\xE9 nos trajeron
          aqu\xED?"
        anxietyDelta: 15
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Lisa
        text: "Lo sab\xEDa. Desde el principio supe que algo no cuadraba. La escena
          era demasiado perfecta."
        anxietyDelta: 5
        requiredFlag: 
        setFlag: 
        addInventoryItemId: 
      - speaker: Narrador
        text: "El grupo estalla en caos. La confianza que quedaba se desmorona. Todos
          miran a los dem\xE1s con sospecha. Alguien en esta habitaci\xF3n sabe la
          verdad. Y est\xE1 aqu\xED contigo."
        anxietyDelta: 10
        requiredFlag: 
        setFlag: chapter3.group_confronted
        addInventoryItemId: 
      choices: []
      nextNodeIdIfNoChoices: 
      endsConversation: 1
